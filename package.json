{
  "name": "ventana-magica",
  "version": "0.3.0",
  "private": true,
  "description": "Ventana Mágica: web app local para niños hospitalizados. Sin dependencias.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node servidor/servidor.mjs",
    "test": "node --test web/lib/*.test.mjs servidor/*.test.mjs",
    "certificados": "bash scripts/certificados.sh",
    "voz": "bash scripts/instalar-voz.sh",
    "paquete": "bash scripts/paquete.sh",
    "demo": "VP_DEMO=1 node servidor/servidor.mjs",
    "comprobar": "bash scripts/comprobar.sh",
    "ia": "bash scripts/instalar-ia.sh",
    "medir-voz": "node scripts/medir-voz.mjs"
  }
}
